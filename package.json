{
  "name": "nexolab-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:lint-staged",
    "test:lint-staged": "node scripts/tests/lint-staged-v17.mjs",
    "test:watch": "vitest",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:security": "playwright test --config=playwright.security.config.ts",
    "test:e2e:dashboard": "playwright test --config=playwright.dashboard.config.ts",
    "test:e2e:sessions": "playwright test --config=playwright.sessions.config.ts",
    "test:e2e:alerts": "playwright test --config=playwright.alerts.config.ts",
    "test:e2e:reports": "playwright test --config=playwright.reports.config.ts",
    "test:e2e:rendered-reports": "playwright test --config=playwright.rendered-reports.config.ts",
    "test:e2e:nodes": "playwright test --config=playwright.nodes.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --write src/components/alerts/alerts-telemetry-scope.tsx && git diff -- src/components/alerts/alerts-telemetry-scope.tsx && exit 1",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "clsx": "^2.1.1",
    "echarts": "6.1.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "jsdom": "30.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "description": "NEXOLAB cold-chain and laboratory IoT monitoring dashboard.",
  "engines": {
    "node": ">=22.22.1 <23 || >=24 <25",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "postcss": "8.5.20",
    "sharp": "0.35.3"
  }
}
