# Bind to loopback by default. Keep this value when using Secure MCP Tunnel or a local reverse proxy.
NEXOLAB_MCP_HOST=127.0.0.1
NEXOLAB_MCP_PORT=8787

# Existing NEXOLAB services.
NEXOLAB_TELEMETRY_API_URL=http://127.0.0.1:8100
NEXOLAB_NODES_API_URL=http://127.0.0.1:8100

# Optional credential used by MCP -> NEXOLAB backend requests.
# Prefer a dedicated least-privilege service credential. Never commit the real value.
NEXOLAB_BACKEND_BEARER_TOKEN=

# Recommended even on private networks. Mandatory by code when binding to a non-loopback address.
# Generate with: openssl rand -hex 32
NEXOLAB_MCP_BEARER_TOKEN=

# Required for non-loopback binds. Hostnames only, comma-separated, without schemes or ports.
# NEXOLAB_MCP_ALLOWED_HOSTS=mcp.example.com
NEXOLAB_MCP_ALLOWED_HOSTS=

# Browser Origin hostnames allowed to access /mcp. Empty means the Host allow-list is reused.
# NEXOLAB_MCP_ALLOWED_ORIGINS=chatgpt.com
NEXOLAB_MCP_ALLOWED_ORIGINS=

# Safety/resource limits.
NEXOLAB_MCP_REQUEST_TIMEOUT_MS=8000
NEXOLAB_MCP_MAX_LATEST_ITEMS=200
NEXOLAB_MCP_MAX_HISTORY_ITEMS=500
NEXOLAB_MCP_MAX_HISTORY_HOURS=744
