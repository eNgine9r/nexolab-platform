FROM node:22-alpine AS dependencies

WORKDIR /app
ENV HUSKY=0

COPY package.json ./
RUN npm install --ignore-scripts --no-audit --no-fund

FROM node:22-alpine AS builder

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_NEXOLAB_DATA_MODE=live
ARG NEXT_PUBLIC_NEXOLAB_API_BASE_URL
ARG NEXT_PUBLIC_NEXOLAB_WEBSOCKET_URL
ARG NEXT_PUBLIC_NEXOLAB_OPERATOR_ID=dashboard-operator
ARG NEXT_PUBLIC_NEXOLAB_ACCEPTANCE_EQUIPMENT_ENABLED=false

ENV NEXT_PUBLIC_NEXOLAB_DATA_MODE=$NEXT_PUBLIC_NEXOLAB_DATA_MODE
ENV NEXT_PUBLIC_NEXOLAB_API_BASE_URL=$NEXT_PUBLIC_NEXOLAB_API_BASE_URL
ENV NEXT_PUBLIC_NEXOLAB_WEBSOCKET_URL=$NEXT_PUBLIC_NEXOLAB_WEBSOCKET_URL
ENV NEXT_PUBLIC_NEXOLAB_OPERATOR_ID=$NEXT_PUBLIC_NEXOLAB_OPERATOR_ID
ENV NEXT_PUBLIC_NEXOLAB_ACCEPTANCE_EQUIPMENT_ENABLED=$NEXT_PUBLIC_NEXOLAB_ACCEPTANCE_EQUIPMENT_ENABLED

COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN mkdir -p public && npm run build

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

CMD ["node", "server.js"]
