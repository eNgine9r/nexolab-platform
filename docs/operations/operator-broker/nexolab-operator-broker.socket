# NEXOLAB Operator Broker socket (#1758). Owner-installed to /etc/systemd/system/.
# Only root and the nexolab-dev group can connect; the broker additionally checks the
# kernel peer uid (SO_PEERCRED) against NEXOLAB_OPERATOR_ALLOWED_UIDS.
[Unit]
Description=NEXOLAB Operator Broker socket (bounded local operations for the dev account)

[Socket]
ListenStream=/run/nexolab-operator/broker.sock
SocketUser=root
SocketGroup=nexolab-dev
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no

[Install]
WantedBy=sockets.target
