# /etc/nexolab-storage/housekeeping.env (root, 0644). No secrets.
# Scheduled runs only REPORT and write a manifest. Apply happens only manually with
#   --apply-manifest <manifest> --manifest-sha256 <approved hash>
# Release roots whose <sha>-<stamp> directories may be pruned (colon-separated).
STORAGE_RELEASE_ROOTS=/home/nexolab/nexolab-platform/runtime/frontend-releases
# Records searched for references (rollback manifests, deployment and recovery
# evidence, offline bundle manifests, backups, workspaces). A release or image
# named in any of them is REVIEW, never a candidate. Missing roots are skipped;
# an unreadable root withholds all image and release candidates.
STORAGE_REFERENCE_ROOTS=/home/nexolab/nexolab-platform/runtime:/home/nexolab/nexolab-platform/.project:/home/nexolab/commander-workspaces:/var/backups/nexolab:/etc/nexolab
STORAGE_KEEP_RELEASES=3
STORAGE_MIN_RELEASE_AGE_DAYS=14
STORAGE_MIN_IMAGE_AGE_DAYS=7
STORAGE_BUILD_CACHE_AGE_HOURS=168
STORAGE_WARN_GIB=40
STORAGE_CRITICAL_GIB=20
# Both inventories are REQUIRED; if either is missing, empty or unreadable, no
# image or release candidate is produced (fail closed).
STORAGE_PROTECTED_PATHS_FILE=/etc/nexolab-storage/protected-paths
STORAGE_PROTECTED_IMAGES_FILE=/etc/nexolab-storage/protected-images
