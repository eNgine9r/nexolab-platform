# Optional Telegram delivery adapter. Core NEXOLAB does not require this file.
TELEGRAM_ENABLED=false
TELEGRAM_MINIAPP_ENABLED=false
TELEGRAM_GATEWAY_PORT=8090
TELEGRAM_MINIAPP_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_GATEWAY_IMAGE=nexolab-telegram-gateway:local
TELEGRAM_GATEWAY_SECRETS_DIR=/etc/nexolab/telegram

# Runtime destination/config only. Do not hard-code these in product code.
TELEGRAM_DESTINATION_CHAT_ID=
TELEGRAM_MINI_APP_URL_TEMPLATE=
TELEGRAM_NEXOLAB_BACKEND_ORGANIZATION_ID=
TELEGRAM_NEXOLAB_BACKEND_USERNAME=
TELEGRAM_NEXOLAB_BACKEND_AUTH_MODE=local

# Bounded delivery behavior.
TELEGRAM_POLL_INTERVAL_SECONDS=30
TELEGRAM_MAX_ATTEMPTS=6
TELEGRAM_RETRY_INITIAL_SECONDS=5
TELEGRAM_RETRY_MAX_SECONDS=300
TELEGRAM_MAX_DELIVERIES_PER_RUN=50
