# NEXOLAB dual RS-485 software configuration example.
#
# This file is documentation only. Do not use it as a site cutover command.
# Physical adapter installation, field wiring migration and hardware acceptance
# require a separately approved hardware action.

NEXOLAB_NODE_ID=edge-01
HARDWARE_DEVICE_MODE=xjp60d
RS485_GROUP_GID=20

# compose.hardware.yaml keeps this legacy stable path mandatory so removing
# RS485_BUS_CONFIG_JSON has a deterministic single-bus rollback path. In dual
# mode the bus-aware runtime uses the explicit per-bus paths below instead.
RS485_HOST_DEVICE=/dev/serial/by-id/REPLACE_WITH_KK1_ADAPTER

# Repository-backed controller topology:
#   KK2: XJP60D Unit IDs 101..115
#   KK1: XJP60D Unit IDs 126..138
# The container sees the host /dev tree read-only under /host/dev.
RS485_BUS_CONFIG_JSON=[{"bus_id":"rs485-kk1","serial_device":"/host/dev/serial/by-id/REPLACE_WITH_KK1_ADAPTER","unit_ids":[126,127,128,129,130,131,132,133,134,135,136,137,138],"baudrate":9600,"parity":"N","stopbits":1,"timeout_seconds":0.30,"retries":1},{"bus_id":"rs485-kk2","serial_device":"/host/dev/serial/by-id/REPLACE_WITH_KK2_ADAPTER","unit_ids":[101,102,103,104,105,106,107,108,109,110,111,112,113,114,115],"baudrate":9600,"parity":"N","stopbits":1,"timeout_seconds":0.30,"retries":1}]

XJP60D_POINTS=106:3,106:4
XJP60D_DISCOVERY_UNITS=101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,126,127,128,129,130,131,132,133,134,135,136,137,138
XJP60D_SCALE=0.1

# LE-01MP bus ownership is not established by current repository evidence.
# Keep meters out of this XJP-only example. Before HARDWARE_DEVICE_MODE=modbus,
# add every configured meter Unit ID to exactly one bus unit_ids list and set
# LE01MP_UNIT_IDS explicitly. The runtime rejects any unassigned registry unit.
LE01MP_UNIT_IDS=

SERIAL_TIMEOUT_SECONDS=0.30
SERIAL_RETRIES=1
