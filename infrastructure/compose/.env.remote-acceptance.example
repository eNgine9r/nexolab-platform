# Run this gate from a real operator workstation that is logged in to the same tailnet.
NEXOLAB_REMOTE_DASHBOARD_URL=https://nexolab-central.example-tailnet.ts.net
NEXOLAB_REMOTE_API_URL=https://nexolab-central.example-tailnet.ts.net:8443
NEXOLAB_REMOTE_STORAGE_ORIGIN=https://nexolab-central.example-tailnet.ts.net:9443
NEXOLAB_REMOTE_WEBSOCKET_URL=wss://nexolab-central.example-tailnet.ts.net:8443/api/v1/telemetry/live

# Must equal the Tailscale-User-Login value injected by Tailscale Serve.
NEXOLAB_EXPECTED_OPERATOR_LOGIN=operator@example.com

# Optional. Leave unset to generate a unique acceptance-<timestamp> id.
# NEXOLAB_REMOTE_EQUIPMENT_ID=acceptance-central-host-20260725

# Optional local evidence directory and browser mode.
# NEXOLAB_REMOTE_EVIDENCE_DIR=runtime/evidence/refrigeration-remote-acceptance-manual
NEXOLAB_REMOTE_HEADLESS=true
PLAYWRIGHT_INSTALL_WITH_DEPS=0
