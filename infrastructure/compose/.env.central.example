# Central host network boundary. Tailscale Serve proxies only to loopback.
CENTRAL_BIND_ADDRESS=127.0.0.1
CENTRAL_DASHBOARD_PORT=3000
CENTRAL_API_PORT=8082
CENTRAL_MQTT_PORT=1884
CENTRAL_OBJECT_STORAGE_PORT=9000
CENTRAL_OBJECT_STORAGE_CONSOLE_PORT=9001

# Versioned application images used by controlled rollout and rollback.
NEXOLAB_DASHBOARD_IMAGE=nexolab-dashboard:local
TELEMETRY_SERVICE_IMAGE=nexolab-telemetry-service:local
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

POSTGRES_DB=nexolab
POSTGRES_USER=nexolab
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Private S3-compatible equipment-image storage. The bucket remains anonymous-disabled.
MINIO_ROOT_USER=nexolab-storage
MINIO_ROOT_PASSWORD=replace-with-another-long-random-secret
OBJECT_STORAGE_BUCKET=nexolab-equipment-images
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=https://nexolab-central.example-tailnet.ts.net:9443
OBJECT_STORAGE_REGION=us-east-1
EQUIPMENT_IMAGE_MAX_BYTES=15728640
EQUIPMENT_IMAGE_SIGNED_URL_SECONDS=900

# Tailscale Serve HTTPS origins. Replace the example FQDN with `tailscale status --json` Self.DNSName.
TAILSCALE_NODE_FQDN=nexolab-central.example-tailnet.ts.net
TAILSCALE_DASHBOARD_HTTPS_PORT=443
TAILSCALE_API_HTTPS_PORT=8443
TAILSCALE_STORAGE_HTTPS_PORT=9443

# Dashboard public values are embedded at image build time.
NEXT_PUBLIC_NEXOLAB_DATA_MODE=live
NEXT_PUBLIC_NEXOLAB_API_BASE_URL=https://nexolab-central.example-tailnet.ts.net:8443
NEXT_PUBLIC_NEXOLAB_WEBSOCKET_URL=wss://nexolab-central.example-tailnet.ts.net:8443/api/v1/telemetry/live
NEXT_PUBLIC_NEXOLAB_OPERATOR_ID=dashboard-operator
NEXT_PUBLIC_NEXOLAB_ACCEPTANCE_EQUIPMENT_ENABLED=false

# Canonical edge-01 route. Must match infrastructure/compose/.env.edge.
MQTT_TOPIC=nexolab/telemetry
MQTT_CLIENT_ID=nexolab-central-telemetry-ingestion

# Exact browser origin. Do not use * in the controlled profile.
CORS_ALLOWED_ORIGINS=https://nexolab-central.example-tailnet.ts.net
CORS_ALLOW_CREDENTIALS=false

# Trust Tailscale Serve identity headers only while the API remains loopback-bound.
OPERATOR_IDENTITY_MODE=tailscale_serve

DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_RETRY_INITIAL_SECONDS=0.25
DATABASE_RETRY_MAX_SECONDS=5
INGESTION_QUEUE_MAXSIZE=10000
INGESTION_PAYLOAD_MAX_BYTES=262144
DEAD_LETTER_PAYLOAD_MAX_BYTES=65536
API_MAX_PAGE_SIZE=1000
HISTORY_MAX_RANGE_DAYS=31
WEBSOCKET_CLIENT_QUEUE_MAXSIZE=256
WEBSOCKET_HEARTBEAT_SECONDS=20
WEBSOCKET_SEND_TIMEOUT_SECONDS=5
WEBSOCKET_RESUME_LIMIT=1000
RETENTION_ENABLED=true
TELEMETRY_RETENTION_DAYS=365
RAW_PAYLOAD_RETENTION_DAYS=30
DEAD_LETTER_RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600
RETENTION_BATCH_SIZE=1000
