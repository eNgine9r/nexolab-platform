# Central host network boundary. Keep loopback for a same-host dashboard.
# Set an explicit trusted LAN or VPN interface address only when remote access is required.
CENTRAL_BIND_ADDRESS=127.0.0.1
CENTRAL_API_PORT=8082
CENTRAL_MQTT_PORT=1884
CENTRAL_OBJECT_STORAGE_PORT=9000
CENTRAL_OBJECT_STORAGE_CONSOLE_PORT=9001

# Versioned application and object-storage images used by controlled rollout and rollback.
TELEMETRY_SERVICE_IMAGE=nexolab-telemetry-service:local
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

POSTGRES_DB=nexolab
POSTGRES_USER=nexolab
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Private S3-compatible equipment-image storage. Keep the API and console on the trusted bind address.
MINIO_ROOT_USER=nexolab-storage
MINIO_ROOT_PASSWORD=replace-with-another-long-random-secret
OBJECT_STORAGE_BUCKET=nexolab-equipment-images
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
EQUIPMENT_IMAGE_MAX_BYTES=1572864
EQUIPMENT_IMAGE_SIGNED_URL_SECONDS=900

# Canonical edge-01 route. Must match infrastructure/compose/.env.edge.
MQTT_TOPIC=nexolab/telemetry
MQTT_CLIENT_ID=nexolab-central-telemetry-ingestion

# Comma-separated browser origins. Do not use * in the controlled profile.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# Authentication is disabled only for isolated development. Controlled LOCAL_LAN deployment uses
# AUTH_MODE=jwt together with compose.local-auth.yaml or an explicitly configured external JWT provider.
AUTH_MODE=disabled
AUTH_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# Local operator authentication. These files are created and owned by the operator and are never bundled.
AUTH_LOCAL_PRIVATE_KEY_HOST_FILE=./secrets/local-auth/private.pem
AUTH_LOCAL_PUBLIC_KEY_HOST_FILE=./secrets/local-auth/public.pem
AUTH_LOCAL_ISSUER=urn:nexolab:local
AUTH_LOCAL_AUDIENCE=nexolab-api
AUTH_LOCAL_ACCESS_TOKEN_SECONDS=300
AUTH_LOCAL_REFRESH_TOKEN_SECONDS=43200
AUTH_LOCAL_MAX_FAILED_ATTEMPTS=5
AUTH_LOCAL_LOCKOUT_SECONDS=300

# Optional external provider. Configure either a static public key or a trusted JWKS endpoint only when
# compose.local-auth.yaml is not used. Never commit private keys or user tokens.
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_JWKS_URL=https://replace-with-identity-host/.well-known/jwks.json
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ISSUER=https://replace-with-identity-host
AUTH_JWT_AUDIENCE=replace-with-api-audience
AUTH_JWT_PROVIDER=oidc

DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_RETRY_INITIAL_SECONDS=0.25
DATABASE_RETRY_MAX_SECONDS=5
INGESTION_QUEUE_MAXSIZE=10000
INGESTION_PAYLOAD_MAX_BYTES=262144
DEAD_LETTER_PAYLOAD_MAX_BYTES=65536
API_MAX_PAGE_SIZE=1000
HISTORY_MAX_RANGE_DAYS=31
WEBSOCKET_CLIENT_QUEUE_MAXSIZE=256
WEBSOCKET_HEARTBEAT_SECONDS=20
WEBSOCKET_SEND_TIMEOUT_SECONDS=5
WEBSOCKET_RESUME_LIMIT=1000
RETENTION_ENABLED=true
TELEMETRY_RETENTION_DAYS=365
RAW_PAYLOAD_RETENTION_DAYS=30
DEAD_LETTER_RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600
RETENTION_BATCH_SIZE=1000
