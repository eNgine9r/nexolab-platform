# Exact Node Registry identity. These values are not secrets.
NEXOLAB_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
NEXOLAB_NODE_ID=edge-01
MQTT_USERNAME=node:00000000-0000-0000-0000-000000000001:edge-01
MQTT_CLIENT_ID=nexolab-00000000-0000-0000-0000-000000000001-edge-01

# Trusted central Mosquitto endpoint. TLS/LAN hostname validation remains a
# deferred physical-host Gate; do not point this profile at a public broker.
CENTRAL_MQTT_HOST=192.168.1.10
CENTRAL_MQTT_PORT=1883

# Host path to the one-time credential returned by Node Registry. The password
# itself must never be copied into this file or committed to git.
EDGE_MQTT_PASSWORD_FILE=/opt/nexolab/secrets/edge-01/mqtt-password

DEVICE_MODE=simulator
SAMPLE_INTERVAL_SECONDS=5
NODE_HEALTH_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
DEVICE_AGENT_HEALTH_PORT=8081
DEVICE_AGENT_IMAGE=ghcr.io/engine9r/nexolab-device-agent:edge
EDGE_DATA_VOLUME=nexolab-edge-01-data

# Used only when compose.hardware.yaml is added during an explicit hardware Gate.
RS485_HOST_DEVICE=/dev/serial/by-id/replace-with-stable-adapter-id
RS485_GROUP_GID=20
HARDWARE_DEVICE_MODE=modbus
XJP60D_POINTS=106:3,106:4
XJP60D_SCALE=0.1
LE01MP_UNIT_IDS=200,201,202,203
SERIAL_TIMEOUT_SECONDS=0.30
SERIAL_RETRIES=1
