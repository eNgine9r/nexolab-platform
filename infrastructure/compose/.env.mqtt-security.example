# Central broker identities. Passwords are mounted from files, never stored here.
MQTT_ADMIN_USERNAME=nexolab-security-admin
MQTT_INGESTION_USERNAME=nexolab-central-ingestion
MQTT_INGESTION_CLIENT_ID=nexolab-central-ingestion
MQTT_SECURITY_SECRETS_DIR=/opt/nexolab/secrets/mqtt-central
MQTT_NODE_REGISTRY_ENFORCED=true

# Edge bridge identity example.
NEXOLAB_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
NEXOLAB_NODE_ID=edge-01
CENTRAL_BRIDGE_CLIENT_ID=nexolab-00000000-0000-0000-0000-000000000001-edge-01
CENTRAL_MQTT_USERNAME=node:00000000-0000-0000-0000-000000000001:edge-01
MQTT_NODE_SECRETS_DIR=/opt/nexolab/secrets/mqtt-edge-01
