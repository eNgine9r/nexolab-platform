# Central broker identities. Passwords and encryption keys are mounted from files,
# never stored in this environment file.
MQTT_ADMIN_USERNAME=nexolab-security-admin
MQTT_INGESTION_USERNAME=nexolab-central-ingestion
MQTT_INGESTION_CLIENT_ID=nexolab-central-ingestion
MQTT_SECURITY_SECRETS_DIR=/opt/nexolab/secrets/mqtt-central
MQTT_NODE_REGISTRY_ENFORCED=true

# Broker-control envelope key identity and bounded worker tuning.
# Required mounted files inside MQTT_SECURITY_SECRETS_DIR:
#   admin-password
#   ingestion-password
#   broker-control-key   (one base64url-encoded 32-byte AES key)
BROKER_CONTROL_ENCRYPTION_KEY_ID=broker-control-v1
BROKER_CONTROL_ADMIN_CLIENT_ID=nexolab-broker-control-worker
BROKER_CONTROL_POLL_INTERVAL_SECONDS=1
BROKER_CONTROL_MAX_COMMANDS_PER_RUN=25
BROKER_CONTROL_MAX_ATTEMPTS=8
BROKER_CONTROL_RETRY_INITIAL_SECONDS=1
BROKER_CONTROL_RETRY_MAX_SECONDS=300
BROKER_CONTROL_COMMAND_TIMEOUT_SECONDS=15
BROKER_CONTROL_STALE_LOCK_SECONDS=60

# Edge bridge identity example.
NEXOLAB_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
NEXOLAB_NODE_ID=edge-01
CENTRAL_BRIDGE_CLIENT_ID=nexolab-00000000-0000-0000-0000-000000000001-edge-01
CENTRAL_MQTT_USERNAME=node:00000000-0000-0000-0000-000000000001:edge-01
MQTT_NODE_SECRETS_DIR=/opt/nexolab/secrets/mqtt-edge-01
