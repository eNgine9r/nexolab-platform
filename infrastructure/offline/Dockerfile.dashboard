ARG NODE_IMAGE=node:24-bookworm-slim

FROM ${NODE_IMAGE} AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS builder
ARG NEXT_PUBLIC_NEXOLAB_DATA_MODE=live
ARG NEXT_PUBLIC_NEXOLAB_API_BASE_URL
ARG NEXT_PUBLIC_NEXOLAB_WEBSOCKET_URL
ARG NEXT_PUBLIC_NEXOLAB_AUTH_PROVIDER=disabled
ARG NEXT_PUBLIC_NEXOLAB_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
ENV NEXT_PUBLIC_NEXOLAB_DATA_MODE=${NEXT_PUBLIC_NEXOLAB_DATA_MODE} \
    NEXT_PUBLIC_NEXOLAB_API_BASE_URL=${NEXT_PUBLIC_NEXOLAB_API_BASE_URL} \
    NEXT_PUBLIC_NEXOLAB_WEBSOCKET_URL=${NEXT_PUBLIC_NEXOLAB_WEBSOCKET_URL} \
    NEXT_PUBLIC_NEXOLAB_AUTH_PROVIDER=${NEXT_PUBLIC_NEXOLAB_AUTH_PROVIDER} \
    NEXT_PUBLIC_NEXOLAB_ORGANIZATION_ID=${NEXT_PUBLIC_NEXOLAB_ORGANIZATION_ID} \
    NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN test -n "$NEXT_PUBLIC_NEXOLAB_API_BASE_URL" \
    && test -n "$NEXT_PUBLIC_NEXOLAB_WEBSOCKET_URL" \
    && npm run build \
    && npm prune --omit=dev

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=builder --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
