[Unit]
Description=NEXOLAB bounded local version manager
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/nexolab/version-manager.env
ExecStart=/usr/bin/env NEXOLAB_STARTUP_EVIDENCE_ROOT=/var/backups/nexolab/device-agent-startup /usr/bin/python3 /usr/local/lib/nexolab/nexolab-version-manager.py run-once --root $NEXOLAB_VERSION_ROOT --central-env $NEXOLAB_CENTRAL_ENV --edge-env $NEXOLAB_EDGE_ENV --backup-dir $NEXOLAB_VERSION_BACKUP_DIR $NEXOLAB_VERSION_MANAGER_FLAGS
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/nexolab/version-management /var/backups/nexolab -/opt/nexolab-external/releases -/etc/systemd/system/nexolab-external-frontend.service
